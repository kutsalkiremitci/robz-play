// Robz Play frame generation - builds the in-between NV12 picture.
//
// The flow network gives, for the wanted point in time, a motion field towards
// each of the two source frames and a blend mask (5 channels: f0.x f0.y f1.x f1.y
// mask), possibly at a fraction of the picture size. This pass samples both source
// frames in their native NV12 form along those motion vectors and blends them, so
// the generated picture keeps the full resolution and the exact colour encoding of
// the stream - there is no RGB round trip.
//
// Static picture elements. A game's HUD (text, map frame, icons) does not move while
// the scene behind it does, and the motion field, being smooth, tends to drag such
// elements along with the background: in the generated frame the text is displaced or
// smeared, in the real frames it is not, and the alternation shows as shimmer. So each
// pixel is checked against a second hypothesis, "nothing moved here": if the two source
// frames agree with each other at this very position clearly better than they agree
// along the motion vectors, the pixel is taken straight from the sources instead.
// Where the motion field is right, both hypotheses fit equally well (or motion fits
// better) and nothing changes.
//
// Each invocation writes one 32-bit word of luma (four pixels) and, on even rows,
// one word of chroma (two Cb, Cr pairs): whole words, so invocations never race on
// a word and no 8-bit storage extension is needed.
//
// 10-bit pictures (P010: 16-bit words, the value in the upper bits) take the same path.
// A sample is read as its 16-bit word divided by 256, which is its value on the 8-bit
// scale with a fraction, so every threshold below means the same for both; four pixels
// are then two words of luma, and two Cb, Cr pairs two words of chroma.

#version 450

#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif

layout (binding = 0) readonly buffer field_blob { sfp field_data[]; };
layout (binding = 1) readonly buffer y0_blob { uint y0_data[]; };
layout (binding = 2) readonly buffer uv0_blob { uint uv0_data[]; };
layout (binding = 3) readonly buffer y1_blob { uint y1_data[]; };
layout (binding = 4) readonly buffer uv1_blob { uint uv1_data[]; };
layout (binding = 5) writeonly buffer oy_blob { uint oy_data[]; };
layout (binding = 6) writeonly buffer ouv_blob { uint ouv_data[]; };

layout (push_constant) uniform parameter
{
    int w;      // picture width
    int h;      // picture height
    int nw;     // network width without padding
    int nh;     // network height without padding
    int tw;     // field tensor width (padded)
    int tcstep; // field tensor channel step
    int k;      // picture pixels per network pixel
    float t;    // position of the generated frame between frame 0 (0.0) and frame 1 (1.0)
    int protect_static; // 0 switches the static-element check off
    float field_t;      // the point in time the motion field was estimated for
    int bicubic;        // 0 fetches luma bilinearly (softer), otherwise with the bicubic kernel
    int wide;           // 0: samples are bytes, 1: 16-bit words (P010)
} p;

// How much better (in 8-bit luma levels per pixel) the "nothing moved" hypothesis has to
// fit before it starts to win, and over what range it takes over completely.
const float STATIC_MARGIN = 4.0f;
const float STATIC_RANGE = 6.0f;
// How little a pixel may differ between the two frames (8-bit levels) to count as
// unchanged at all; allows for compression noise on a static element.
const float STATIC_LEVEL = 3.0f;
const float STATIC_LEVEL_RANGE = 5.0f;

float field(int c, int x, int y)
{
    return float(field_data[c * p.tcstep + y * p.tw + x]);
}

// The motion field as the network produced it: motion towards frame 0 and frame 1 (in
// picture pixels) and the blend weight of frame 0, for a position in picture luma
// coordinates at the time the field was estimated for.
void read_field(vec2 pos, out vec2 f0, out vec2 f1, out float m)
{
    vec2 n = (pos + 0.5f) / float(p.k) - 0.5f;
    n = clamp(n, vec2(0.f), vec2(float(p.nw - 1), float(p.nh - 1)));
    ivec2 i0 = ivec2(floor(n));
    vec2 a = n - vec2(i0);
    ivec2 i1 = min(i0 + ivec2(1), ivec2(p.nw - 1, p.nh - 1));

    float v[5];
    for (int c = 0; c < 5; c++)
    {
        v[c] = mix(mix(field(c, i0.x, i0.y), field(c, i1.x, i0.y), a.x),
                   mix(field(c, i0.x, i1.y), field(c, i1.x, i1.y), a.x), a.y);
    }
    float scale = float(p.k);
    f0 = vec2(v[0], v[1]) * scale;
    f1 = vec2(v[2], v[3]) * scale;
    m = clamp(v[4], 0.f, 1.f);
}

// Motion and blend weight for the frame being generated (time p.t).
//
// One motion field serves several generated frames: the network runs once per pair of
// source frames, for the middle of the interval, and frames at other times are derived
// from that field. A point that sits at x when the field is valid has moved on by
// (p.t - p.field_t) of the way between the frames; so for an output pixel, step back by
// that much to find where its point was, read the field there, and correct the two
// vectors for the step. The blend weight shifts towards the frame that is nearer in time.
void sample_field(vec2 pos, out vec2 f0, out vec2 f1, out float m)
{
    read_field(pos, f0, f1, m);
    float dt = p.t - p.field_t;
    if (abs(dt) < 0.0001f)
        return;

    vec2 shift = dt * (f1 - f0);
    vec2 g0;
    vec2 g1;
    float gm;
    read_field(pos - shift, g0, g1, gm);
    f0 = g0 - shift;
    f1 = g1 - shift;
    float w0 = gm * (1.f - p.t);
    float w1 = (1.f - gm) * p.t;
    m = (w0 + w1) > 0.00001f ? w0 / (w0 + w1) : 0.5f;
}

float y0_at(int x, int y)
{
    int i = clamp(y, 0, p.h - 1) * p.w + clamp(x, 0, p.w - 1);
    if (p.wide != 0)
        return float((y0_data[i >> 1] >> uint((i & 1) * 16)) & 0xFFFFu) * (1.f / 256.f);
    return float((y0_data[i >> 2] >> uint((i & 3) * 8)) & 0xFFu);
}

float y1_at(int x, int y)
{
    int i = clamp(y, 0, p.h - 1) * p.w + clamp(x, 0, p.w - 1);
    if (p.wide != 0)
        return float((y1_data[i >> 1] >> uint((i & 1) * 16)) & 0xFFFFu) * (1.f / 256.f);
    return float((y1_data[i >> 2] >> uint((i & 3) * 8)) & 0xFFu);
}

vec2 uv0_at(int cx, int cy)
{
    int i = clamp(cy, 0, p.h / 2 - 1) * p.w + clamp(cx, 0, p.w / 2 - 1) * 2;
    if (p.wide != 0)
    {
        uint pair = uv0_data[i >> 1];
        return vec2(float(pair & 0xFFFFu), float(pair >> 16u)) * (1.f / 256.f);
    }
    uint word = uv0_data[i >> 2];
    uint shift = uint((i & 3) * 8);
    return vec2(float((word >> shift) & 0xFFu), float((word >> (shift + 8u)) & 0xFFu));
}

vec2 uv1_at(int cx, int cy)
{
    int i = clamp(cy, 0, p.h / 2 - 1) * p.w + clamp(cx, 0, p.w / 2 - 1) * 2;
    if (p.wide != 0)
    {
        uint pair = uv1_data[i >> 1];
        return vec2(float(pair & 0xFFFFu), float(pair >> 16u)) * (1.f / 256.f);
    }
    uint word = uv1_data[i >> 2];
    uint shift = uint((i & 3) * 8);
    return vec2(float((word >> shift) & 0xFFu), float((word >> (shift + 8u)) & 0xFFu));
}

// Luma is fetched with a bicubic (Catmull-Rom) kernel rather than bilinearly. A generated
// frame is made of pixels taken from between the source pixels, and bilinear filtering
// softens every one of them a little - visibly so when most of the frames on screen are
// generated ones. The bicubic kernel keeps the detail; clamping the result to the range of
// the four nearest pixels takes away the ringing such a kernel would otherwise leave
// around sharp edges.
vec4 cubic_weights(float f)
{
    float f2 = f * f;
    float f3 = f2 * f;
    return vec4(-0.5f * f3 + f2 - 0.5f * f,
                1.5f * f3 - 2.5f * f2 + 1.f,
                -1.5f * f3 + 2.f * f2 + 0.5f * f,
                0.5f * f3 - 0.5f * f2);
}

float luma0(vec2 pos)
{
    ivec2 i = ivec2(floor(pos));
    vec2 a = pos - vec2(i);
    if (p.bicubic == 0)
    {
        return mix(mix(y0_at(i.x, i.y), y0_at(i.x + 1, i.y), a.x),
                   mix(y0_at(i.x, i.y + 1), y0_at(i.x + 1, i.y + 1), a.x), a.y);
    }
    vec4 wx = cubic_weights(a.x);
    vec4 wy = cubic_weights(a.y);
    float lo = 256.f;
    float hi = 0.f;
    float sum = 0.f;
    for (int dy = -1; dy <= 2; dy++)
    {
        float row = 0.f;
        for (int dx = -1; dx <= 2; dx++)
        {
            float v = y0_at(i.x + dx, i.y + dy);
            row += wx[dx + 1] * v;
            if (dx >= 0 && dx <= 1 && dy >= 0 && dy <= 1)
            {
                lo = min(lo, v);
                hi = max(hi, v);
            }
        }
        sum += wy[dy + 1] * row;
    }
    return clamp(sum, lo, hi);
}

float luma1(vec2 pos)
{
    ivec2 i = ivec2(floor(pos));
    vec2 a = pos - vec2(i);
    if (p.bicubic == 0)
    {
        return mix(mix(y1_at(i.x, i.y), y1_at(i.x + 1, i.y), a.x),
                   mix(y1_at(i.x, i.y + 1), y1_at(i.x + 1, i.y + 1), a.x), a.y);
    }
    vec4 wx = cubic_weights(a.x);
    vec4 wy = cubic_weights(a.y);
    float lo = 256.f;
    float hi = 0.f;
    float sum = 0.f;
    for (int dy = -1; dy <= 2; dy++)
    {
        float row = 0.f;
        for (int dx = -1; dx <= 2; dx++)
        {
            float v = y1_at(i.x + dx, i.y + dy);
            row += wx[dx + 1] * v;
            if (dx >= 0 && dx <= 1 && dy >= 0 && dy <= 1)
            {
                lo = min(lo, v);
                hi = max(hi, v);
            }
        }
        sum += wy[dy + 1] * row;
    }
    return clamp(sum, lo, hi);
}

// `pos` is in luma coordinates; chroma sample (cx, cy) sits at luma (2 * cx, 2 * cy + 0.5)
vec2 chroma0(vec2 pos)
{
    vec2 c = vec2(pos.x * 0.5f, (pos.y - 0.5f) * 0.5f);
    ivec2 i = ivec2(floor(c));
    vec2 a = c - vec2(i);
    return mix(mix(uv0_at(i.x, i.y), uv0_at(i.x + 1, i.y), a.x),
               mix(uv0_at(i.x, i.y + 1), uv0_at(i.x + 1, i.y + 1), a.x), a.y);
}

vec2 chroma1(vec2 pos)
{
    vec2 c = vec2(pos.x * 0.5f, (pos.y - 0.5f) * 0.5f);
    ivec2 i = ivec2(floor(c));
    vec2 a = c - vec2(i);
    return mix(mix(uv1_at(i.x, i.y), uv1_at(i.x + 1, i.y), a.x),
               mix(uv1_at(i.x, i.y + 1), uv1_at(i.x + 1, i.y + 1), a.x), a.y);
}

uint to_byte(float v)
{
    return uint(clamp(floor(v + 0.5f), 0.f, 255.f));
}

// A value on the 8-bit scale as a P010 word: rounded to 10 bits, in the upper bits.
uint to_p010(float v)
{
    return uint(clamp(floor(v * 4.f + 0.5f), 0.f, 1023.f)) << 6u;
}

// 0 = follow the motion field, 1 = this spot is static.
//
// The pixel itself has to be unchanged between the two source frames. Then three
// measurements (absolute luma difference between the two source frames) decide whether
// "nothing moved here" explains it better than the motion field does:
//   in_place      the frames compared at the same position
//   along_motion  the two positions the motion field would fetch this pixel from: small
//                 if the field explains the generated pixel
//   carried       what sits here in one frame against where the field says it went in the
//                 other: small if the content at this position really moved with the field
// A static element under a moving-background field fails at least one of the last two
// while passing the first. `carried` is what catches thin static lines on a plain static
// ground, where the fetched pixels match each other by accident.
//
// The measurements are averaged over a small cross for robustness against noise, but a
// neighbour only counts as far as it is unchanged itself: the letters of a thin text sit
// right next to moving scenery, which must neither dilute nor decide the letter's case.
float static_weight(vec2 pos, vec2 f0, vec2 f1)
{
    if (p.protect_static == 0)
        return 0.f;

    ivec2 base = ivec2(floor(pos + 0.5f));
    float centre_a = y0_at(base.x, base.y);
    float centre_b = y1_at(base.x, base.y);
    float unchanged = 1.f - clamp((abs(centre_a - centre_b) - STATIC_LEVEL) / STATIC_LEVEL_RANGE, 0.f, 1.f);
    if (unchanged <= 0.f)
        return 0.f;

    const ivec2 taps[5] = ivec2[5](ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
    ivec2 moved0 = ivec2(floor(pos + f0 + 0.5f));
    ivec2 moved1 = ivec2(floor(pos + f1 + 0.5f));
    ivec2 travel = ivec2(floor(f1 - f0 + 0.5f)); // displacement from frame 0 to frame 1
    float weight_sum = 0.f;
    float along_motion = 0.f;
    float in_place = 0.f;
    float carried = 0.f;
    for (int i = 0; i < 5; i++)
    {
        ivec2 q = base + taps[i];
        float a = y0_at(q.x, q.y);
        float b = y1_at(q.x, q.y);
        float difference = abs(a - b);
        float weight = i == 0 ? 1.f : 1.f - clamp((difference - STATIC_LEVEL) / STATIC_LEVEL_RANGE, 0.f, 1.f);
        weight_sum += weight;
        in_place += weight * difference;
        along_motion += weight * abs(y0_at(moved0.x + taps[i].x, moved0.y + taps[i].y) - y1_at(moved1.x + taps[i].x, moved1.y + taps[i].y));
        carried += weight * 0.5f * (abs(a - y1_at(q.x + travel.x, q.y + travel.y)) + abs(b - y0_at(q.x - travel.x, q.y - travel.y)));
    }
    float against_motion = max(along_motion, carried) / weight_sum;
    float better = clamp(((against_motion - in_place / weight_sum) - STATIC_MARGIN) / STATIC_RANGE, 0.f, 1.f);
    // a static element is never a single pixel: at least one neighbour has to be unchanged
    // too. This is what keeps moving texture, where a lone pixel now and then happens to
    // keep its value, from being treated as static.
    float supported = clamp(weight_sum - 1.f, 0.f, 1.f);
    return better * unchanged * supported;
}

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);

    int words_per_row = p.w / 4;
    if (gx >= words_per_row || gy >= p.h)
        return;

    int x0 = gx * 4;

    float luma[4];
    for (int i = 0; i < 4; i++)
    {
        vec2 pos = vec2(float(x0 + i), float(gy));
        vec2 f0;
        vec2 f1;
        float m;
        sample_field(pos, f0, f1, m);
        float v = luma0(pos + f0) * m + luma1(pos + f1) * (1.f - m);
        float still = mix(y0_at(x0 + i, gy), y1_at(x0 + i, gy), p.t);
        luma[i] = mix(v, still, static_weight(pos, f0, f1));
    }
    if (p.wide != 0)
    {
        int first = (gy * p.w + x0) / 2;
        oy_data[first] = to_p010(luma[0]) | (to_p010(luma[1]) << 16u);
        oy_data[first + 1] = to_p010(luma[2]) | (to_p010(luma[3]) << 16u);
    }
    else
    {
        oy_data[gy * words_per_row + gx] = to_byte(luma[0]) | (to_byte(luma[1]) << 8u) | (to_byte(luma[2]) << 16u) | (to_byte(luma[3]) << 24u);
    }

    if ((gy & 1) == 0)
    {
        vec2 chroma[2];
        for (int j = 0; j < 2; j++)
        {
            vec2 pos = vec2(float(x0 + j * 2), float(gy) + 0.5f);
            vec2 f0;
            vec2 f1;
            float m;
            sample_field(pos, f0, f1, m);
            vec2 uv = chroma0(pos + f0) * m + chroma1(pos + f1) * (1.f - m);
            int cx = gx * 2 + j;
            int cy = gy / 2;
            vec2 still = mix(uv0_at(cx, cy), uv1_at(cx, cy), p.t);
            chroma[j] = mix(uv, still, static_weight(pos, f0, f1));
        }
        if (p.wide != 0)
        {
            // one word per Cb, Cr pair; a chroma row holds w / 2 of them
            int first = (gy / 2) * (p.w / 2) + gx * 2;
            ouv_data[first] = to_p010(chroma[0].x) | (to_p010(chroma[0].y) << 16u);
            ouv_data[first + 1] = to_p010(chroma[1].x) | (to_p010(chroma[1].y) << 16u);
        }
        else
        {
            ouv_data[(gy / 2) * words_per_row + gx] = to_byte(chroma[0].x) | (to_byte(chroma[0].y) << 8u)
                | (to_byte(chroma[1].x) << 16u) | (to_byte(chroma[1].y) << 24u);
        }
    }
}
